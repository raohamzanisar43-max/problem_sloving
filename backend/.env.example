DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
TIME_ZONE=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# LLM (optional – stub works offline)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Search providers (required only for live collection)
BRAVE_API_KEY=
X_BEARER_TOKEN=

QUALIFICATION_CONFIDENCE=
COLLECTION_INTERVAL_MINUTES=
DUPLICATE_SIMILARITY_THRESHOLD=

# Internal alerting. Leave ALERT_EMAIL blank to disable alert events entirely.
ALERT_EMAIL=
ALERT_MIN_SCORE=

# Celery (optional)
CELERY_TASK_ALWAYS_EAGER=
# CELERY_BROKER_URL=redis://localhost:6379/0

# Microsoft Graph workbook (optional)
MS_GRAPH_WORKBOOK_ID=
MS_GRAPH_TABLE_NAME=
# Reddit (required for Reddit collector)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Email alert delivery
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_FROM=

# Microsoft Graph (optional)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Production hardening — only applied when DJANGO_DEBUG=false.
# Turn these off only if TLS is terminated where Django cannot see it.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
# Irreversible once submitted to the browser preload list — opt in deliberately.
SECURE_HSTS_PRELOAD=
