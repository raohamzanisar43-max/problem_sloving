DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
TIME_ZONE=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# LLM (optional – stub works offline)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Search providers (required only for live collection)
BRAVE_API_KEY=
X_BEARER_TOKEN=

QUALIFICATION_CONFIDENCE=
COLLECTION_INTERVAL_MINUTES=
# Max paid Brave calls per day (0 = no limit) and how often free Freelancer.com is checked
BRAVE_DAILY_CALL_LIMIT=30
FREE_SOURCE_INTERVAL_MINUTES=60
DUPLICATE_SIMILARITY_THRESHOLD=

# Internal alerting. Leave ALERT_EMAIL blank to disable alert events entirely.
ALERT_EMAIL=
ALERT_MIN_SCORE=

# Celery (optional)
CELERY_TASK_ALWAYS_EAGER=
# CELERY_BROKER_URL=redis://localhost:6379/0

# Microsoft Graph workbook (optional)
MS_GRAPH_WORKBOOK_ID=
MS_GRAPH_TABLE_NAME=
# Reddit (required for Reddit collector)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Microsoft Graph (optional)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Production hardening — only applied when DJANGO_DEBUG=false.
# Turn these off only if TLS is terminated where Django cannot see it.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
# Irreversible once submitted to the browser preload list — opt in deliberately.
SECURE_HSTS_PRELOAD=

# Reply mailbox — NovuRadar reads client replies to proposals from it (IMAP,
# read-only) and shows them as notifications. Nothing is emailed on proposals.
EMAIL_HOST=mail.novulabs.net
EMAIL_HOST_USER=info@novulabs.net
EMAIL_HOST_PASSWORD=
# 465 + SSL by default; for 587 set EMAIL_USE_TLS=true
EMAIL_PORT=465
# Optional: also email these addresses when a client replies
TEAM_ALERT_EMAILS=
APP_BASE_URL=https://novuradar.novulabs.net

# Optional: read replies from a different mailbox than the one above
INBOX_IMAP_HOST=
INBOX_EMAIL=
INBOX_PASSWORD=
INBOX_CHECK_MINUTES=5

# Reddit hiring posts are fetched through Apify (pay-per-post, roughly $1 per
# 1,000 posts; only [Hiring]/[Task] and client-phrase posts are fetched).
# Token: apify.com → Settings → API & Integrations. Checked every 12 hours.
APIFY_TOKEN=
REDDIT_INTERVAL_MINUTES=720
