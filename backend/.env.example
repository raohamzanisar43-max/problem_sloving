DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Karachi

# Optional PostgreSQL (leave blank to use SQLite)
# POSTGRES_DB=novu_radar
# POSTGRES_USER=novu
# POSTGRES_PASSWORD=novu
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# LLM (optional – stub works offline)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Search providers (required only for live collection)
BRAVE_API_KEY=
X_BEARER_TOKEN=

QUALIFICATION_CONFIDENCE=0.75
COLLECTION_INTERVAL_MINUTES=15
DUPLICATE_SIMILARITY_THRESHOLD=0.80

# Internal alerting. Leave ALERT_EMAIL blank to disable alert events entirely.
ALERT_EMAIL=
ALERT_MIN_SCORE=80

# Celery (optional)
CELERY_TASK_ALWAYS_EAGER=true
# CELERY_BROKER_URL=redis://localhost:6379/0

# Microsoft Graph workbook (optional)
MS_GRAPH_WORKBOOK_ID=
MS_GRAPH_TABLE_NAME=OpportunityRadar
# Reddit (required for Reddit collector)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=novu-radar/1.0

# Email alert delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=novu-radar@example.com

# Microsoft Graph (optional)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Production hardening — only applied when DJANGO_DEBUG=false.
# Turn these off only if TLS is terminated where Django cannot see it.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Irreversible once submitted to the browser preload list — opt in deliberately.
SECURE_HSTS_PRELOAD=false
