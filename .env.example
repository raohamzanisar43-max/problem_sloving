# Compose configuration for `docker compose up`.
# Copy to .env and set at least DJANGO_SECRET_KEY.
#
# For local (non-Docker) development, use backend/.env.example instead.

DJANGO_SECRET_KEY=generate-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost
TIME_ZONE=Asia/Karachi
HTTP_PORT=80

POSTGRES_DB=novu_radar
POSTGRES_USER=novu
POSTGRES_PASSWORD=change-me

COLLECTION_INTERVAL_MINUTES=15
QUALIFICATION_CONFIDENCE=0.75

# Extraction provider: stub | openai | azure | gemini
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Connector credentials — only needed once a source is enabled.
BRAVE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Internal alerting (leave ALERT_EMAIL blank to disable).
ALERT_EMAIL=
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# Cloud workbook sync (Microsoft Graph).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_WORKBOOK_ID=

# Production hardening — only applied when DJANGO_DEBUG=false.
# Turn these off only if TLS is terminated where Django cannot see it.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Irreversible once submitted to the browser preload list — opt in deliberately.
SECURE_HSTS_PRELOAD=false
