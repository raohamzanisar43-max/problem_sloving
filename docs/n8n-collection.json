      "typeVersion": 1,
      "position": [200, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://radar.example.invalid/api/v1/runs/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"trigger\": \"n8n_scheduled\",\n  \"scope\": \"enabled\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "http-queue-run",
      "name": "Queue Collection Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 380],
      "credentials": {
        "httpHeaderAuth": {
          "id": "novu-radar-service-token",
          "name": "Novu Radar Header Auth"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (Every 15m)": {
      "main": [
        [
          {
            "node": "Queue Collection Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Queue Collection Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Karachi"
